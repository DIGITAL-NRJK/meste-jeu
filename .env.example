# Pooled Neon URL used by the application at runtime.
DATABASE_URL="postgresql://user:password@example-pooler.eu-central-1.aws.neon.tech/database?sslmode=require"

# Direct Neon URL required by Drizzle Kit for schema and migration commands.
DATABASE_URL_UNPOOLED="postgresql://user:password@example.eu-central-1.aws.neon.tech/database?sslmode=require"

APP_URL="http://localhost:3000"

# Generate independent random values of at least 32 characters for real environments.
SESSION_SECRET="replace-with-a-random-session-secret"
ADMIN_AUTH_SECRET="replace-with-a-random-admin-auth-secret"
